# -----------------------------------------------------------------------------
# Server environment template
# Copy to server/.env and fill values per environment.
# -----------------------------------------------------------------------------

# Runtime profile: development | staging | production
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Production example:
# CLIENT_URL=https://splitchill.vercel.app

# Database (use one of MONGO_URI / MONGODB_URI / DB_URI)
# Local Docker compose (replica set enabled)
MONGO_URI=mongodb://mongo:27017/splitchill?replicaSet=rs0
# Atlas / external URI (example)
DB_URI=

# Auth (required in production)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-at-least-16-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_MS=2592000000

# API hardening
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Redis (recommended for socket scaling and distributed deployments)
REDIS_URL=redis://redis:6379
SOCKET_REDIS_URL=redis://redis:6379

# AI - Groq (primary provider)
GROQ_API_KEY=
groq=

# AI - Mistral (optional fallback)
MISTRAL_API_KEY=
Mistral=

# OCR - OCRSpace
OCRSPACE_API_KEY=
OCRSPACE=

# Payment - HyperSwitch
HYPERSWITCH_BASE_URL=https://api.hyperswitch.io
HYPERSWITCH_API_KEY=
HyperID=
HYPERSWITCH_WEBHOOK_SECRET=
HYPERSWITCH_PAYMENT_RESPONSE_HASH_KEY=
HYPERSWITCH_WEBHOOK_TOLERANCE_MS=300000

# SMS - Textbee (optional)
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_WEBHOOK_SECRET=
OTP_TTL_MS=300000
OTP_RATE_LIMIT_PER_15_MIN=3

# Background jobs and retry tuning
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
SMS_RETRY_INTERVAL_MS=120000
SMS_MAX_ATTEMPTS=5
DISABLE_BACKGROUND_JOBS=false

# Development convenience
DEMO_AUTH_ENABLED=true

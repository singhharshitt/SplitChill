NODE_ENV=development
PORT=5000
DB_URI=mongodb+srv://your-connection-string
MONGO_URI=mongodb://127.0.0.1:27017/splitchill
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_MS=2592000000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Redis (required for multi-instance + socket scaling)
REDIS_URL=redis://127.0.0.1:6379
SOCKET_REDIS_URL=redis://127.0.0.1:6379

# AI — Groq (primary AI provider)
groq=gsk_your_groq_api_key_here
# GROQ_API_KEY=gsk_your_groq_api_key_here  # alias also works

# AI — Mistral (optional fallback)
Mistral=your-mistral-api-key
# MISTRAL_API_KEY=your-mistral-api-key  # alias also works

# OCR — OCRSpace (cloud OCR)
OCRSPACE=your-ocrspace-api-key
# OCRSPACE_API_KEY=your-ocrspace-api-key  # alias also works

# Payment — HyperSwitch
HyperID=pk_snd_your-hyperswitch-publishable-key
# HYPERSWITCH_API_KEY=pk_snd_your-key  # alias also works
HYPERSWITCH_BASE_URL=https://api.hyperswitch.io
HYPERSWITCH_WEBHOOK_SECRET=replace-with-payments-response-hash-key
HYPERSWITCH_PAYMENT_RESPONSE_HASH_KEY=replace-with-payments-response-hash-key
HYPERSWITCH_WEBHOOK_TOLERANCE_MS=300000

# SMS — Textbee (optional)
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=replace-with-textbee-api-key
TEXTBEE_DEVICE_ID=replace-with-textbee-device-id
TEXTBEE_WEBHOOK_SECRET=replace-with-textbee-webhook-secret
OTP_TTL_MS=300000
OTP_RATE_LIMIT_PER_15_MIN=3

# Background Jobs
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
SMS_RETRY_INTERVAL_MS=120000
SMS_MAX_ATTEMPTS=5
DISABLE_BACKGROUND_JOBS=false

# Demo login is available only outside production.
# Set to false to hide the two-account browser demo helper.
DEMO_AUTH_ENABLED=true

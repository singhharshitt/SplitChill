# -----------------------------------------------------------------------------
# SplitChill root environment file for Docker Compose and CI image tagging.
# Copy to .env at repository root for local containerized runs.
# -----------------------------------------------------------------------------

# Shared ports
CLIENT_PORT=5173
SERVER_PORT=5001
MONGO_PORT=27017
REDIS_PORT=6379

# Frontend runtime target (used by client build / compose)
VITE_API_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001

# Backend service endpoints
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://mongo:27017/splitchill?replicaSet=rs0
REDIS_URL=redis://redis:6379
SOCKET_REDIS_URL=redis://redis:6379

# Required application secrets (replace in non-dev environments)
JWT_SECRET=replace-with-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-another-32-plus-char-secret

# Optional integrations
HYPERSWITCH_BASE_URL=https://api.hyperswitch.io
HYPERSWITCH_API_KEY=
HYPERSWITCH_WEBHOOK_SECRET=
HYPERSWITCH_PAYMENT_RESPONSE_HASH_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OCRSPACE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_WEBHOOK_SECRET=
DEMO_AUTH_ENABLED=true

# Docker image names and tags (for repeatable builds)
SERVER_IMAGE=splitchill/server
CLIENT_IMAGE=splitchill/client
IMAGE_TAG=dev

# CI/CD deployment integration
DOCKER_REGISTRY=
RENDER_DEPLOY_HOOK_URL=
